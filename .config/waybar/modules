{
        "custom/spotify": {
            "exec": "/usr/bin/python3 ~/.config/waybar/scripts/mediaplayer.py --player spotify",
            "format": "{}  󰓇",
            "return-type": "json",
            "on-click-middle": "playerctl play-pause",
            "on-click": "playerctl previous",
            "on-click-right": "playerctl next"
        },

        "custom/weather": {
            "interval": 600,
            "exec": "wttrbar --location 'Ramnicu Valcea'",
            "format": "{} °C",
            "return-type": "json",
            "tooltip": "true"
        },

        // End of custom modules //
        "hyprland/workspaces": {
            "format": "{id}",
            "format-active": " {id} ",
            "on-click": "activate",
            "active-only": "false",
            "all-outputs": "true"
        },
        "hyprland/window": {
            "separate-outputs": true
        },
        "tray": {
            "icon-size": 18,
            "spacing": 8
        },
        "cpu": {
            "interval": 30,
            "format": "[ CPU {usage}%",
            // "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
            "on-click": "kitty --class system_monitor -e btop"

        },
        "memory": {
            "format": "{percentage}% RAM ]",
            "interval": 30,
            "on-click": "kitty --class system_monitor -e btop",
            "max-lenght": 35
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "{icon} {volume}%",
            "format-bluetooth-muted": "婢  Muted",
            "format-muted": " Muted",
            "format-icons": {
                "headphone": "󰋋",
                "hands-free": "",
                "headset": "󰋋",
                "phone": "󰄜",
                "portable": "",
                "car": "󰸛",
                "default": ["󰕿", "󰖀", "󰕾"]
            },
            "on-click-middle": "pavucontrol",
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-scroll-down": "wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%-",
            "on-scroll-up": "wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%+"
        }
    }