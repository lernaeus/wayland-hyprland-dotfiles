[
    {
        "include": ["~/.config/waybar/modules", "~/.config/waybar/main-monitor-clock"],
        "layer": "top",
        "output": "DP-3",
        "position": "top", 
        "modules-left": ["hyprland/workspaces", "custom/weather", "custom/spotify"],
        "modules-right": ["cpu", "memory", "pulseaudio", "clock", "tray"],
        "modules-center": ["hyprland/window"]
    },
    {
        "include": ["~/.config/waybar/modules", "~/.config/waybar/second-monitor-clock"],
        "layer": "top",
        "output": "HDMI-A-1",
        "position": "top",
        "spacing": "4",
        "modules-left": ["hyprland/workspaces", "custom/spotify"],
        "modules-right": ["cpu", "memory", "custom/weather", "clock", "tray"]
    }
]
